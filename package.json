{
  "name": "vitest-websocket-mock",
  "version": "0.7.0",
  "description": "Mock websockets and assert complex websocket interactions with Vitest",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiomik/vitest-websocket-mock.git"
  },
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run build",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "keywords": [
    "vitest",
    "websocket",
    "mock",
    "unit-testing"
  ],
  "author": "Akiomi Kamakura",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "dependencies": {
    "mock-socket": "^9.2.1"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
